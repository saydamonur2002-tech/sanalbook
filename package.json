{
  "name": "sanalbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check:telif": "node --experimental-strip-types scripts/check-telif.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "build": "npm run check:telif && npm run sitemap && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "wrangler deploy",
    "check": "astro check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/literata": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.8",
    "astro": "^5.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2",
    "wrangler": "^4.155.0"
  }
}
