---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Kirinti from '../../../../components/Kirinti.astro';
import OkumaBar from '../../../../components/OkumaBar.astro';
import { katalogYukle, type CozulmusBolum, type CozulmusEser } from '../../../../lib/katalog';

interface Komsu {
  title: string;
  href: string;
  etiket: string;
}

export async function getStaticPaths() {
  const { eserler } = await katalogYukle();

  function bolumKomsu(bolum: CozulmusBolum | null, yon: 'onceki' | 'sonraki'): Komsu | null {
    if (!bolum) return null;
    return {
      title: bolum.title,
      href: bolum.href,
      etiket: yon === 'onceki' ? 'Önceki' : 'Sonraki',
    };
  }

  function eserKomsu(komsu: CozulmusEser | null): Komsu | null {
    if (!komsu) return null;
    return {
      title: komsu.data.title,
      href: komsu.href,
      etiket: komsu.data.title,
    };
  }

  const gruplar = new Map<string, CozulmusEser[]>();
  for (const eser of eserler) {
    const liste = gruplar.get(eser.kategori.id) ?? [];
    liste.push(eser);
    gruplar.set(eser.kategori.id, liste);
  }
  for (const liste of gruplar.values()) {
    liste.sort((a, b) => a.data.order - b.data.order);
  }

  return eserler.flatMap((eser) => {
    const liste = gruplar.get(eser.kategori.id) ?? [];
    const sira = liste.findIndex((aday) => aday.id === eser.id);
    const oncekiEser = liste[sira - 1] ?? null;
    const sonrakiEser = liste[sira + 1] ?? null;
    return eser.bolumler.map((bolum, index) => {
      const tekBolum = eser.bolumler.length === 1;
      return {
        params: {
          ulke: eser.ulke.slug,
          kategori: eser.kategori.slug,
          eser: eser.data.slug,
          bolum: String(bolum.order),
        },
        props: {
          eser,
          bolum,
          onceki: tekBolum
            ? eserKomsu(oncekiEser)
            : bolumKomsu(eser.bolumler[index - 1] ?? null, 'onceki'),
          sonraki: tekBolum
            ? eserKomsu(sonrakiEser)
            : bolumKomsu(eser.bolumler[index + 1] ?? null, 'sonraki'),
        },
      };
    });
  });
}

interface Props {
  eser: CozulmusEser;
  bolum: CozulmusBolum;
  onceki: Komsu | null;
  sonraki: Komsu | null;
}

const { eser, bolum, onceki, sonraki } = Astro.props;
const { Content } = await render(bolum.entry);
const ayniBaslik = bolum.title === eser.data.title;
const baslik = ayniBaslik ? eser.data.title : bolum.title;
---

<Base
  title={baslik}
  description={`${eser.data.title}, ${eser.data.author}. Bölüm ${bolum.order}.`}
  okuma
>
  <div class="sarmal">
    <Kirinti
      ogeler={[
        { ad: 'Ülkeler', href: '/' },
        { ad: eser.ulke.name, href: `/${eser.ulke.slug}` },
        { ad: eser.kategori.name, href: `/${eser.ulke.slug}/${eser.kategori.slug}` },
        { ad: eser.data.title, href: eser.href },
        { ad: ayniBaslik ? `Bölüm ${bolum.order}` : bolum.title },
      ]}
    />
    <header class="bolum-bas">
      <p class="kicker">
        {eser.bolumler.length === 1
          ? 'Tek bölüm'
          : `Bölüm ${bolum.order} / ${eser.bolumler.length}`}
      </p>
      <h1>{baslik}</h1>
      <p class="yazar">
        {eser.data.author}
        <span class="bos"> · </span>
        <a href={eser.href}>Eser künyesi</a>
      </p>
    </header>
    <article class="bolum">
      <Content />
    </article>
  </div>
  <OkumaBar onceki={onceki} sonraki={sonraki} />
</Base>
